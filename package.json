{
  "name": "learning-dashboard",
  "version": "1.7.2",
  "description": "PEAN的开发小天地",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "lab": "electron prototype/run-lab.js",
    "orb": "electron prototype/run-lab.js orb",
    "test": "node --test tests/*.test.js",
    "verify": "node tests/verify-migration.js",
    "install-local": "node scripts/install-local.js",
    "build": "electron-builder --win"
  },
  "build": {
    "appId": "com.trae.pean-dashboard",
    "productName": "PEAN的开发小天地",
    "directories": {
      "output": "dist"
    },
    "publish": {
      "provider": "generic",
      "url": "https://example.com"
    },
    "files": [
      "main.js",
      "preload.js",
      "ai.js",
      "evidence.js",
      "src/**/*",
      "build/icon.ico"
    ],
    "win": {
      "icon": "build/icon.ico",
      "target": "nsis",
      "sign": false
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "PEAN的开发小天地"
    }
  },
  "devDependencies": {
    "electron": "^33.0.0",
    "electron-builder": "^25.0.0"
  }
}
